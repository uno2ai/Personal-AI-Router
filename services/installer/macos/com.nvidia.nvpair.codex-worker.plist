<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nvidia.nvpair.codex-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/NVIDIA-Personal-AI-Router/bin/nvpair-codex-worker</string>
    <string>--workspace-root</string>
    <string>/path/to/workspace</string>
    <string>--listen</string>
    <string>0.0.0.0:14324</string>
    <string>--cluster-dir</string>
    <string>/path/to/pair-cluster</string>
    <string>--supervisor-allowlist</string>
    <string>MAIN_SUPERVISOR_PRINCIPAL</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/tmp/nvpair-codex-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nvpair-codex-worker.error.log</string>
</dict>
</plist>
